+// ----------------------------------------------------------- open from workspace
+
+/// File › Open from Workspace: the documents the shell can hand over, ticked and opened together
+/// (design, Open from Workspace). Drawn only while the menu item has raised it, and only a shell
+/// that supplied [`crate::Services::workspace`] can reach it.
+pub fn workspace_window(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    if !app.workspace_ui.open {
+        return;
+    }
+    let Some(store) = app.services.workspace.as_ref() else {
+        app.workspace_ui.open = false;
+        return;
+    };
+    // Off the app for the frame: the closure below borrows these, never `app`, because the shell's
+    // own closures borrow `app.services` for as long as the window lives.
+    let mut chosen = std::mem::take(&mut app.workspace_ui.chosen);
+    let (title, listing) = (store.label.trim_end_matches('…').to_string(), (store.listing)());
+    let t = Tokens::get(ctx);
+    let (mut refresh, mut open_now, mut close) = (false, false, false);
+    egui::Window::new(title)
+        .id(egui::Id::new("workspace-open"))
+        .collapsible(false)
+        .resizable(true)
+        .default_width(400.0)
+        .anchor(Align2::CENTER_CENTER, vec2(0.0, 0.0))
+        .show(ctx, |ui| {
+            match &listing {
+                WorkspaceListing::Loading => {
+                    ui.horizontal(|ui| {
+                        ui.spinner();
+                        ui.label(RichText::new("Reading the workspace…").color(t.text_dim).size(12.0));
+                    });
+                }
+                WorkspaceListing::Failed(why) => {
+                    ui.label(RichText::new(why.as_str()).color(t.text).size(12.0));
+                }
+                WorkspaceListing::Ready(documents) if documents.is_empty() => {
+                    ui.label(RichText::new("This workspace holds no documents yet.").color(t.text_dim).size(12.0));
+                }
+                WorkspaceListing::Ready(documents) => {
+                    ui.horizontal(|ui| {
+                        if ui.button("All").clicked() {
+                            chosen = documents.iter().map(|d| d.name.clone()).collect();
+                        }
+                        if ui.button("None").clicked() {
+                            chosen.clear();
+                        }
+                        ui.label(RichText::new(format!("{} document(s)", documents.len())).color(t.text_dim).size(11.0));
+                    });
+                    ui.add_space(4.0);
+                    egui::ScrollArea::vertical().max_height(300.0).show(ui, |ui| {
+                        for d in documents {
+                            let mut on = chosen.contains(&d.name);
+                            let label = format!("{}  ·  {}", d.name, crate::sizing::human_bytes(d.size as f64));
+                            if widgets::checkbox(ui, &mut on, &label).changed() {
+                                if on {
+                                    chosen.insert(d.name.clone());
+                                } else {
+                                    chosen.remove(&d.name);
+                                }
+                            }
+                        }
+                    });
+                }
+            }
+            ui.add_space(8.0);
+            widgets::hairline(ui);
+            ui.add_space(4.0);
+            ui.horizontal(|ui| {
+                let ready = matches!(listing, WorkspaceListing::Ready(ref d) if !d.is_empty());
+                if ui.add_enabled(ready && !chosen.is_empty(), egui::Button::new("Open").selected(true)).clicked() {
+                    open_now = true;
+                }
+                if ui.add_enabled(!matches!(listing, WorkspaceListing::Loading), egui::Button::new("Refresh")).clicked() {
+                    refresh = true;
+                }
+                if ui.button("Cancel").clicked() {
+                    close = true;
+                }
+            });
+        });
+    app.workspace_ui.chosen = chosen;
+    if refresh {
+        (store.refresh)();
+    }
+    if open_now {
+        // The shell reads them and answers through the Inbox a frame or two later, so the window
+        // closes now rather than holding the frame until the bytes arrive.
+        let names: Vec<String> = app.workspace_ui.chosen.iter().cloned().collect();
+        (store.open)(&names);
+        app.workspace_ui.open = false;
+    }
+    if close {
+        app.workspace_ui.open = false;
+    }
+}
