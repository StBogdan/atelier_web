+//! The Atelier Cloud cloudspace, as the editor sees it: the whole of the patch (design, The PhotoCraft Patch).
+//!
+//! Three things:
+//!
+//! - `?project=<id>`, or `?project=<id>&document=<name>`: read that document — the only one when no
+//!   name is given — from `atelier-cloud/projects/<id>/` and hand its bytes to the `Inbox`, so the
+//!   editor opens it (Opening a Project).
+//! - File › Open from Workspace: list that project's documents for the user to pick several, and
+//!   read the ticked ones into the `Inbox` the same way (Open from Workspace).
+//! - a save of a document the project holds, or the save that makes its first document: answer with
+//!   the path it goes to, `atelier-cloud://<id>/<name>`, which `write` puts back under a Web Lock
+//!   (Saving). Every other save the editor asks for — an export, above all — is answered the way the
+//!   shell answers it, which on the web is a download to the user's own disk.
+//!
+//! It speaks only the OPFS contract — `atelier-cloud/`, `provider.json`, `projects/`, `tmp/`, the
+//! lock and channel names of Coordination Primitives, and `web-sys`, never Atelier web's internals,
+//! so an Atelier web release cannot force a patch release (Keeping the Patch Re-appliable). What to
+//! open stays Atelier web's job: this module reads the document it is told about, and lists the ones
+//! the user asked to choose from (Selection, Open from Workspace).
+//!
+//! The sections named in parentheses are in `atelier_web_design.md`, in Atelier web's repository:
+//! `hook/README.md` there has the whole story.
+
+use std::cell::RefCell;
+use std::future::Future;
+use std::rc::Rc;
+use std::sync::{Arc, Mutex};
+
+use js_sys::{Function, Promise, Reflect};
+use photocraft_ui_egui::{FileDialogAnswer, FileDialogReply, FileDialogRequest, WorkspaceDocument, WorkspaceListing, WorkspaceOpen};
+use wasm_bindgen::closure::Closure;
+use wasm_bindgen::{JsCast as _, JsValue};
+use wasm_bindgen_futures::{JsFuture, future_to_promise, spawn_local};
+use web_sys::{FileSystemDirectoryHandle, FileSystemFileHandle, FileSystemWritableFileStream};
+
+/// The inbox `services()` drains every frame (`crate::web::Inbox`), as (name, bytes, where they came
+/// from). The path is the workspace document a save goes back to (Saving).
+pub type Inbox = Arc<Mutex<Vec<(String, Vec<u8>, Option<String>)>>>;
+
+// Contract names (design: Layout, Saving, Coordination Primitives). A versioned interface: do not rename.
+const SPACE: &str = "atelier-cloud";
+const PROVIDER: &str = "provider.json";
+const PROJECTS: &str = "projects";
+const TMP: &str = "tmp";
+const CHANNEL: &str = "atelier-cloud";
+const LOCK: &str = "atelier-cloud:project:";
+const SCHEME: &str = "atelier-cloud://";
+
+/// The `provider.json` protocol this patch speaks.
+const PROTOCOL: f64 = 1.0;
+/// The extension a project's documents are stored under (Documents).
+const EXTENSION: &str = "pcraft";
+/// The layered formats a document of a project can be stored in: what the editor suggests when a
+/// document has no file of its own to save back to (Save As).
+const LAYERED: &[&str] = &["pcraft", "psd", "psb", "ora"];
+/// Atelier web's own files inside a project directory (Documents): never documents, whatever the
+/// editor could read.
+const PROJECT_FILES: &[&str] = &["meta.json", "pending.json", "thumb.png", "bucket.json"];
+
+/// The project this page was launched into (`?project=`). One per page: a document's own virtual
+/// path is what binds it, so several open documents need nothing per document here.
+struct Binding {
+    project: String,
+}
+
+thread_local! {
+    /// The session-scoped binding (Selection): set once, from `services()`.
+    static BINDING: RefCell<Option<Binding>> = const { RefCell::new(None) };
+}
+
+fn with_binding<R>(action: impl FnOnce(&mut Binding) -> R) -> Option<R> {
+    BINDING.with(|binding| binding.borrow_mut().as_mut().map(action))
+}
+
+fn bound_project() -> Option<String> {
+    with_binding(|binding| binding.project.clone())
+}
+
+/// Bind this page to `?project=<id>` and open the document it names — or the project's only one,
+/// when it names none (design, Opening a Project). Called once, from `services()`; a page without
+/// the query parameter behaves exactly as before.
+pub fn start(inbox: Inbox) {
+    let Some((project, document)) = query_launch() else { return };
+    BINDING.with(|binding| *binding.borrow_mut() = Some(Binding { project: project.clone() }));
+    spawn_local(async move {
+        if let Err(e) = check_provider().await {
+            log::warn!("atelier-cloud: {e}");
+            return;
+        }
+        match read_document(&project, document.as_deref()).await {
+            Ok((name, bytes)) => {
+                log::info!("atelier-cloud: opening {name} ({} bytes) from project {project}", bytes.len());
+                let path = document_path(&project, &name);
+                inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes, Some(path)));
+                wake();
+            }
+            // A project without a document yet is not an error: Save creates one (Selection).
+            Err(e) => log::info!("atelier-cloud: no document to open in project {project}: {e}"),
+        }
+    });
+}
+
+/// Whether this dialog belongs to the cloudspace (The Hook Point): a save asked for on a page that
+/// is bound to a project. Which saves those are is [`save_target`]'s to say; one that is not the
+/// project's is answered exactly as the shell answers it, so claiming it changes nothing.
+///
+/// File › Open is deliberately not claimed. The browser's picker is the only way a local file gets
+/// in, and a workspace document is opened from File › Open from Workspace instead, so the two are
+/// separate doors rather than one request that has to guess (Open from Workspace).
+pub fn claims(request: &FileDialogRequest) -> bool {
+    matches!(request, FileDialogRequest::Save { .. }) && bound_project().is_some()
+}
+
+/// Answer a dialog [`claims`] took: the project's virtual path for a save of the project's own
+/// document, and the shell's own answer for anything else (Saving).
+pub fn answer(request: FileDialogRequest, reply: FileDialogReply) {
+    match request {
+        FileDialogRequest::Save { suggested } => {
+            // Which documents the project holds is an asynchronous read, so the answer is sent the
+            // way the browser picker's is: when it arrives, with the save waiting on it.
+            spawn_local(async move {
+                let path = match save_target(&suggested).await {
+                    Some(path) => path,
+                    // Not the project's save: the shell's answer, which on the web is the file's own
+                    // name, and a name with no project in it is written out to the user's disk.
+                    None => file_name(&suggested),
+                };
+                reply.send(Some(FileDialogAnswer::SaveTo(path)));
+            });
+        }
+        // `claims` takes only Save, so nothing else reaches `answer`: the arm keeps a request
+        // variant upstream adds from breaking the build, as Folder did before v0.8.2.
+        _ => {}
+    }
+}
+
+/// The button label and the page it goes to, for the Home screen the shell wrapped the editor with
+/// (The Hook Point). `None` unless this page was launched into a project, which leaves the screen
+/// exactly as upstream draws it.
+pub fn home_link() -> Option<(String, String)> {
+    with_binding(|binding| ("Back to Atelier Cloud".to_owned(), format!("/cloud/workspace/{}", binding.project)))
+}
+
+/// The project and document an `atelier-cloud://` path names (Saving), if it names one at all.
+pub fn target(path: &str) -> Option<(String, String)> {
+    let (project, document) = path.strip_prefix(SCHEME)?.split_once('/')?;
+    (!project.is_empty() && !document.is_empty()).then(|| (project.to_owned(), document.to_owned()))
+}
+
+/// Write a save into the project its path names (Saving).
+///
+/// The write is asynchronous: OPFS cannot be written synchronously from the main thread, and the
+/// editor's write service is synchronous. Failure is logged; what actually happened to the file is
+/// Atelier web's to derive from the filesystem (File Ownership).
+pub fn write(project: &str, document: &str, bytes: &[u8]) -> Result<(), String> {
+    let (project, document, bytes) = (project.to_owned(), document.to_owned(), bytes.to_vec());
+    let len = bytes.len();
+    spawn_local(async move {
+        match save_document(&project, document.clone(), bytes).await {
+            Ok(()) => {
+                log::info!("atelier-cloud: saved {document} ({len} bytes) into project {project}");
+                ping(&project, &document, len);
+            }
+            Err(e) => log::error!("atelier-cloud: could not save {document} into project {project}: {e}"),
+        }
+    });
+    Ok(())
+}
+
+/// The write sequence of Saving: one writer per project, the previous bytes kept beside the
+/// document, the new bytes staged in `tmp/`, then swapped in.
+async fn save_document(project: &str, document: String, bytes: Vec<u8>) -> Result<(), String> {
+    let project_dir = project_dir(project).await?;
+    let staging = tmp_dir(&space().await?).await?;
+    let staged = unique_name();
+    let previous_name = format!("{document}.prev");
+    with_lock(&format!("{LOCK}{project}"), "exclusive", async move {
+        // A project being saved for the first time has no previous bytes to keep.
+        if let Ok(previous) = read_file(&project_dir, &document).await {
+            write_file(&project_dir, &previous_name, &previous).await?;
+        }
+        write_file(&staging, &staged, &bytes).await?;
+        write_file(&project_dir, &document, &bytes).await?;
+        remove_file(&staging, &staged).await;
+        Ok(())
+    })
+    .await
+}
+
+/// The document `document` names, or the project's only one when it names none, read under a shared
+/// lock so a concurrent swap (Saving) cannot catch it half-written.
+async fn read_document(project: &str, document: Option<&str>) -> Result<(String, Vec<u8>), String> {
+    let dir = project_dir(project).await?;
+    let name = match document {
+        Some(name) => name.to_owned(),
+        None => document_name(&dir).await?.ok_or_else(|| format!("{PROJECTS}/{project} holds no document"))?,
+    };
+    let bytes = with_lock(&format!("{LOCK}{project}"), "shared", {
+        let (dir, name) = (dir.clone(), name.clone());
+        async move { read_file(&dir, &name).await }
+    })
+    .await?;
+    Ok((name, bytes))
+}
+
+/// Where a save asked for with `suggested` goes, or `None` when the project is not the answer and
+/// the shell's own is (Saving).
+///
+/// Two saves are the project's. One is a document it already holds, by that name: the editor asks
+/// where to put a document back, and the answer is the path it was opened from, so a PNG edited in
+/// a workspace is saved as that PNG and no new file appears beside it. The other is the save that
+/// makes the project's first document, so a document drawn here stays here rather than going out to
+/// the user's disk (Selection).
+///
+/// Everything else the editor asks to save — every export (Export As, Save for Web, Save a Copy,
+/// Quick Export), and a document saved under a name the project does not hold — is answered the way
+/// the shell answers it with no project bound, which on the web writes the file out to the user's
+/// own disk. An export belongs there: it is the file the user asked for a copy of, and filing it
+/// into the workspace would hide it in storage they cannot see.
+async fn save_target(suggested: &str) -> Option<String> {
+    let project = bound_project()?;
+    let name = file_name(suggested);
+    let dir = project_dir(&project).await.ok()?;
+    let documents: Vec<String> = names(&dir).await.unwrap_or_default().into_iter().filter(|existing| is_document_name(existing)).collect();
+    let extension = extension_of(&name);
+    if documents.iter().any(|existing| existing == &name) {
+        return Some(document_path(&project, &name));
+    }
+    // The save that makes the project's first document, so a document drawn here stays here rather
+    // than going out to the user's disk (Selection). Only a format a document of a project is
+    // stored in: the export dialog's own formats are flat ones, and an export is the shell's.
+    (documents.is_empty() && LAYERED.contains(&extension.as_str()))
+        // `.pcraft` rather than the suggested name, the extension a project's documents are stored
+        // under, so the document carries a revision (Documents).
+        .then(|| document_path(&project, &format!("{}.{EXTENSION}", stem(&name))))
+}
+
+/// `atelier-cloud/provider.json`, and whether it declares the protocol this patch speaks (Layout).
+async fn check_provider() -> Result<(), String> {
+    let bytes = read_file(&space().await?, PROVIDER).await.map_err(|e| format!("{SPACE}/{PROVIDER} is unreadable: {e}"))?;
+    let text = String::from_utf8(bytes).map_err(|_| format!("{SPACE}/{PROVIDER} is not UTF-8"))?;
+    let declared =
+        js_sys::JSON::parse(&text).ok().and_then(|provider| Reflect::get(&provider, &JsValue::from_str("protocol")).ok()).and_then(|version| version.as_f64());
+    match declared {
+        Some(PROTOCOL) => Ok(()),
+        Some(version) => Err(format!("{SPACE}/{PROVIDER} declares protocol {version}, this editor speaks {PROTOCOL}")),
+        None => Err(format!("{SPACE}/{PROVIDER} does not declare a protocol version")),
+    }
+}
+
+/// Tell Atelier web a document changed (Saving, step 6, and Coordination Primitives). A latency optimization only: it
+/// re-scans OPFS, which is what keeps it correct when this message is lost.
+fn ping(project: &str, document: &str, bytes: usize) {
+    let message = js_sys::Object::new();
+    for (key, value) in [
+        ("type", JsValue::from_str("document-saved")),
+        ("project", JsValue::from_str(project)),
+        ("document", JsValue::from_str(document)),
+        ("bytes", JsValue::from_f64(bytes as f64)),
+        ("at", JsValue::from_f64(js_sys::Date::now())),
+    ] {
+        if Reflect::set(&message, &JsValue::from_str(key), &value).is_err() {
+            return;
+        }
+    }
+    let Some(channel) = broadcast_channel() else { return };
+    if let Ok(post) = Reflect::get(&channel, &JsValue::from_str("postMessage")).and_then(|function| function.dyn_into::<Function>()) {
+        post.call1(&channel, &message).ok();
+    }
+    if let Ok(close) = Reflect::get(&channel, &JsValue::from_str("close")).and_then(|function| function.dyn_into::<Function>()) {
+        close.call0(&channel).ok();
+    }
+}
+
+fn broadcast_channel() -> Option<JsValue> {
+    let window = web_sys::window()?;
+    let constructor = Reflect::get(&window, &JsValue::from_str("BroadcastChannel")).ok()?.dyn_into::<Function>().ok()?;
+    Reflect::construct(&constructor, &js_sys::Array::of1(&JsValue::from_str(CHANNEL))).ok()
+}
+
+/// eframe paints only when something asks it to, and a synthetic `popstate` is one of the events
+/// its web runner repaints on. Without this, bytes arriving from OPFS would wait for a mouse move.
+/// Nothing else observes the event.
+fn wake() {
+    if let Some(window) = web_sys::window()
+        && let Ok(event) = web_sys::Event::new("popstate")
+    {
+        window.dispatch_event(&event).ok();
+    }
+}
+
+/// The `?project=<id>&document=<name>` of Opening a Project. Project ids are Atelier web's,
+/// `[A-Za-z0-9_-]` only, so they reach the page unescaped; a document name is a file name inside the
+/// project directory (Identifiers).
+fn query_launch() -> Option<(String, Option<String>)> {
+    let search = web_sys::window()?.location().search().ok()?;
+    let parameter = |wanted: &str| {
+        search.trim_start_matches('?').split('&').find_map(|pair| {
+            let (key, value) = pair.split_once('=')?;
+            (key == wanted && !value.is_empty()).then(|| value.to_owned())
+        })
+    };
+    let project = parameter("project").filter(|id| is_project_id(id))?;
+    let document = parameter("document").filter(|name| is_document_name(name));
+    Some((project, document))
+}
+
+/// A document name as the contract defines it (Documents): a file name inside the project
+/// directory — no separator, no leading dot — that is not one of Atelier web's own files and not a
+/// one-save-back shadow. Any other format is a document, because the editor decides by content
+/// which files it can read (a `.pcraft`, a PSD, a PNG), so one it cannot opens with that error
+/// rather than being hidden here. A name that is not a document name is refused rather than turned
+/// into a path.
+fn is_document_name(name: &str) -> bool {
+    !name.is_empty() && !name.starts_with('.') && !name.contains('/') && !name.ends_with(".prev") && !PROJECT_FILES.contains(&name)
+}
+
+/// The virtual path a document of `project` is opened and saved under (Saving).
+fn document_path(project: &str, document: &str) -> String {
+    format!("{SCHEME}{project}/{document}")
+}
+
+fn is_project_id(id: &str) -> bool {
+    id.len() <= 64 && id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+}
+
+fn file_name(path: &str) -> String {
+    path.rsplit('/').next().filter(|name| !name.is_empty()).unwrap_or(path).to_owned()
+}
+
+fn stem(name: &str) -> String {
+    match name.rsplit_once('.') {
+        Some((base, extension)) if !base.is_empty() && !extension.is_empty() => base.to_owned(),
+        _ => name.to_owned(),
+    }
+}
+
+fn extension_of(name: &str) -> String {
+    name.rsplit_once('.').map(|(base, extension)| if base.is_empty() { String::new() } else { extension.to_ascii_lowercase() }).unwrap_or_default()
+}
+
+fn js_error(error: JsValue) -> String {
+    format!("{error:?}")
+}
+
+/// `navigator.locks.request(name, {mode}, callback)`, at the level of the API itself: the typed
+/// `LockManager` bindings are behind `web_sys_unstable_apis`, which this build does not set.
+///
+/// The caller's work is awaited inside the callback, so the lock is held until it finishes. `work`
+/// is lazy: nothing it does happens before the lock is granted.
+async fn with_lock<R: 'static>(name: &str, mode: &str, work: impl Future<Output = Result<R, String>> + 'static) -> Result<R, String> {
+    let slot: Rc<RefCell<Option<Result<R, String>>>> = Rc::new(RefCell::new(None));
+    let guarded = {
+        let slot = Rc::clone(&slot);
+        future_to_promise(async move {
+            *slot.borrow_mut() = Some(work.await);
+            Ok(JsValue::UNDEFINED)
+        })
+    };
+    let callback = Closure::once_into_js(move |_lock: JsValue| guarded);
+    let held = locks_request(name, mode, &callback)?;
+    JsFuture::from(held).await.map_err(js_error)?;
+    let done = slot.borrow_mut().take();
+    done.unwrap_or_else(|| Err(format!("the `{name}` lock was never granted")))
+}
+
+fn locks_request(name: &str, mode: &str, callback: &JsValue) -> Result<Promise, String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let locks = Reflect::get(&window.navigator(), &JsValue::from_str("locks")).map_err(js_error)?;
+    let request = Reflect::get(&locks, &JsValue::from_str("request"))
+        .map_err(js_error)?
+        .dyn_into::<Function>()
+        .map_err(|_| "navigator.locks.request is missing".to_owned())?;
+    let options = js_sys::Object::new();
+    Reflect::set(&options, &JsValue::from_str("mode"), &JsValue::from_str(mode)).map_err(js_error)?;
+    request
+        .call3(&locks, &JsValue::from_str(name), &options, callback)
+        .map_err(js_error)?
+        .dyn_into::<Promise>()
+        .map_err(|_| "navigator.locks.request returned no promise".to_owned())
+}
+
+/// The OPFS root at `navigator.storage.getDirectory()`.
+async fn root() -> Result<FileSystemDirectoryHandle, String> {
+    let storage = web_sys::window().ok_or("no window")?.navigator().storage();
+    JsFuture::from(storage.get_directory())
+        .await
+        .map_err(js_error)?
+        .dyn_into::<FileSystemDirectoryHandle>()
+        .map_err(|_| "the OPFS root is not a directory".to_owned())
+}
+
+/// `atelier-cloud/` (Layout). Read-only: Atelier web owns it, and the patch never creates it.
+async fn space() -> Result<FileSystemDirectoryHandle, String> {
+    directory(&root().await?, SPACE, false).await.map_err(|_| format!("{SPACE}/ is missing: open the editor through Atelier Cloud"))
+}
+
+async fn project_dir(project: &str) -> Result<FileSystemDirectoryHandle, String> {
+    let projects =
+        directory(&space().await?, PROJECTS, false).await.map_err(|_| format!("{SPACE}/{PROJECTS}/ is missing: open the editor through Atelier Cloud"))?;
+    directory(&projects, project, false).await.map_err(|_| format!("there is no {SPACE}/{PROJECTS}/{project}/"))
+}
+
+/// `atelier-cloud/tmp/`: write staging (Layout). Atelier web creates it; the patch creates it too,
+/// so a save cannot fail because the space was made by an older provider.
+async fn tmp_dir(space: &FileSystemDirectoryHandle) -> Result<FileSystemDirectoryHandle, String> {
+    directory(space, TMP, true).await
+}
+
+async fn directory(parent: &FileSystemDirectoryHandle, name: &str, create: bool) -> Result<FileSystemDirectoryHandle, String> {
+    let options = web_sys::FileSystemGetDirectoryOptions::new();
+    options.set_create(create);
+    JsFuture::from(parent.get_directory_handle_with_options(name, &options))
+        .await
+        .map_err(js_error)?
+        .dyn_into::<FileSystemDirectoryHandle>()
+        .map_err(|_| format!("`{name}` is not a directory"))
+}
+
+/// The project's first document in name order (Documents): what a consumer that only knows the
+/// project opens, and the only document of a project that never held more than one.
+async fn document_name(dir: &FileSystemDirectoryHandle) -> Result<Option<String>, String> {
+    let mut names: Vec<String> = names(dir).await?.into_iter().filter(|name| is_document_name(name)).collect();
+    names.sort();
+    Ok(names.into_iter().next())
+}
+
+async fn names(dir: &FileSystemDirectoryHandle) -> Result<Vec<String>, String> {
+    let keys = dir.keys();
+    let mut names = Vec::new();
+    loop {
+        let step = JsFuture::from(keys.next().map_err(js_error)?).await.map_err(js_error)?;
+        if Reflect::get(&step, &JsValue::from_str("done")).map_err(js_error)?.as_bool() == Some(true) {
+            return Ok(names);
+        }
+        if let Some(name) = Reflect::get(&step, &JsValue::from_str("value")).map_err(js_error)?.as_string() {
+            names.push(name);
+        }
+    }
+}
+
+async fn read_file(dir: &FileSystemDirectoryHandle, name: &str) -> Result<Vec<u8>, String> {
+    let handle =
+        JsFuture::from(dir.get_file_handle(name)).await.map_err(js_error)?.dyn_into::<FileSystemFileHandle>().map_err(|_| format!("`{name}` is not a file"))?;
+    let file = JsFuture::from(handle.get_file()).await.map_err(js_error)?;
+    let buffer =
+        JsFuture::from(file.dyn_into::<web_sys::File>().map_err(|_| format!("`{name}` did not read as a file"))?.array_buffer()).await.map_err(js_error)?;
+    Ok(js_sys::Uint8Array::new(&buffer).to_vec())
+}
+
+/// Write `bytes` to `name`, replacing it. `close()` swaps the finished file in, so a reader never
+/// sees a partial write and a killed tab leaves the previous bytes in place.
+async fn write_file(dir: &FileSystemDirectoryHandle, name: &str, bytes: &[u8]) -> Result<(), String> {
+    let options = web_sys::FileSystemGetFileOptions::new();
+    options.set_create(true);
+    let handle = JsFuture::from(dir.get_file_handle_with_options(name, &options))
+        .await
+        .map_err(js_error)?
+        .dyn_into::<FileSystemFileHandle>()
+        .map_err(|_| format!("`{name}` is not a file"))?;
+    let stream = JsFuture::from(handle.create_writable())
+        .await
+        .map_err(js_error)?
+        .dyn_into::<FileSystemWritableFileStream>()
+        .map_err(|_| format!("`{name}` is not writable"))?;
+    JsFuture::from(stream.write_with_js_u8_array(&js_bytes(bytes)?).map_err(js_error)?).await.map_err(js_error)?;
+    JsFuture::from(stream.close()).await.map_err(js_error)?;
+    Ok(())
+}
+
+/// The bytes `write()` is handed: a `Uint8Array` backed by an `ArrayBuffer` of its own.
+///
+/// WebKit's `write()` writes the whole backing buffer of a typed-array view and ignores its
+/// `byteOffset` and `byteLength`, and `write_with_u8_array` reaches it as a view into the wasm
+/// linear memory (a `ptr`/`len` pair) — so the file would become that memory, not the document, and
+/// the bytes the editor saved would not be the bytes the editor reads back. A copy is what makes
+/// the write mean what it says.
+fn js_bytes(bytes: &[u8]) -> Result<js_sys::Uint8Array, String> {
+    let len = u32::try_from(bytes.len()).map_err(|_| format!("{} bytes is too large to write", bytes.len()))?;
+    let out = js_sys::Uint8Array::new_with_length(len);
+    out.copy_from(bytes);
+    Ok(out)
+}
+
+async fn remove_file(dir: &FileSystemDirectoryHandle, name: &str) {
+    JsFuture::from(dir.remove_entry(name)).await.ok();
+}
+
+/// A name for the staging file (`tmp/<uuid>`, Saving).
+fn unique_name() -> String {
+    format!("{:x}{:08x}", js_sys::Date::now() as u64, (js_sys::Math::random() * f64::from(u32::MAX)) as u32)
+}
+
+/// Whether this page was launched into a project: the one condition that decides whether the editor
+/// takes what the reader opens, lists the workspace's documents, and shows the way back.
+pub fn bound() -> bool {
+    with_binding(|_| ()).is_some()
+}
+
+/// Take picked files into the bound project (design, Import on Open). Called only when [`bound`]: each
+/// document arrives through the `Inbox` bound to the file it was written to.
+///
+/// This is what keeps "I opened it in the editor" and "it is in the workspace" the same thing: a
+/// document picked from this computer is written into the project as it opens, not only when it is
+/// saved, so closing the editor cannot leave the reader thinking a workspace holds files it does not.
+pub fn take(files: Vec<(String, Vec<u8>)>, inbox: Inbox) {
+    let Some(project) = bound_project() else { return };
+    for (name, bytes) in files {
+        let document = document_file_name(&name);
+        let path = document_path(&project, &document);
+        let (project, inbox) = (project.clone(), inbox.clone());
+        let len = bytes.len();
+        spawn_local(async move {
+            let written = save_document(&project, document.clone(), bytes.clone()).await;
+            match &written {
+                Ok(()) => {
+                    log::info!("atelier-cloud: imported {document} ({len} bytes) into project {project}");
+                    ping(&project, &document, len);
+                }
+                Err(e) => log::error!("atelier-cloud: could not import {document} into project {project}: {e}"),
+            }
+            // Bound to the file when the write landed, unbound when it did not: the document opens
+            // either way, and a Save that follows files it into the project (Saving).
+            let path = written.is_ok().then_some(path);
+            inbox.lock().unwrap_or_else(|e| e.into_inner()).push((document, bytes, path));
+            wake();
+        });
+    }
+}
+
+/// The name a picked file is stored under (Documents): its own name, with any path part and leading
+/// dot dropped, and `.<EXTENSION>` when it has no extension of its own. The editor decides which
+/// reader to use by extension or magic bytes, so a name it arrives under is the name it keeps.
+fn document_file_name(name: &str) -> String {
+    let base = file_name(name).trim_start_matches('.').to_owned();
+    if base.is_empty() {
+        return format!("document.{EXTENSION}");
+    }
+    if extension_of(&base).is_empty() {
+        return format!("{base}.{EXTENSION}");
+    }
+    base
+}
+
+// ------------------------------------------------------------------- open from workspace
+
+thread_local! {
+    /// The project's documents as of the last read, for File › Open from Workspace. The window asks
+    /// every frame and OPFS cannot be read on the UI thread, so the answer is cached here and
+    /// refreshed when the window opens.
+    static LISTING: RefCell<WorkspaceListing> = const { RefCell::new(WorkspaceListing::Loading) };
+}
+
+/// The store File › Open from Workspace opens, or `None` on a page that is not bound to a project —
+/// which leaves the menu item out entirely (Open from Workspace).
+pub fn workspace_open(inbox: Inbox) -> Option<WorkspaceOpen> {
+    let project = bound_project()?;
+    let (refreshing, opening) = (project.clone(), project);
+    Some(WorkspaceOpen {
+        label: "Open from Workspace…".to_owned(),
+        listing: Box::new(|| LISTING.with(|listing| listing.borrow().clone())),
+        refresh: Box::new(move || refresh_listing(refreshing.clone())),
+        open: Box::new(move |names: &[String]| open_documents(opening.clone(), names.to_vec(), inbox.clone())),
+    })
+}
+
+/// Read the project's documents again, for the window to show.
+fn refresh_listing(project: String) {
+    LISTING.with(|listing| *listing.borrow_mut() = WorkspaceListing::Loading);
+    spawn_local(async move {
+        let read = async {
+            check_provider().await?;
+            list_documents(&project).await
+        }
+        .await;
+        LISTING.with(|listing| {
+            *listing.borrow_mut() = match read {
+                Ok(documents) => {
+                    log::info!("atelier-cloud: {project} holds {} document(s)", documents.len());
+                    WorkspaceListing::Ready(documents)
+                }
+                Err(e) => WorkspaceListing::Failed(e),
+            };
+        });
+        wake();
+    });
+}
+
+/// The project's documents, in name order, with the size of each (Layout).
+async fn list_documents(project: &str) -> Result<Vec<WorkspaceDocument>, String> {
+    let dir = project_dir(project).await?;
+    let mut names: Vec<String> = names(&dir).await?.into_iter().filter(|name| is_document_name(name)).collect();
+    names.sort();
+    let mut documents = Vec::with_capacity(names.len());
+    for name in names {
+        let size = document_size(&dir, &name).await.unwrap_or(0);
+        documents.push(WorkspaceDocument { name, size });
+    }
+    Ok(documents)
+}
+
+/// A document's size, or `None` when it cannot be read: a listing is not worth failing over.
+async fn document_size(dir: &FileSystemDirectoryHandle, name: &str) -> Option<u64> {
+    let handle = JsFuture::from(dir.get_file_handle(name)).await.ok()?.dyn_into::<FileSystemFileHandle>().ok()?;
+    let file = JsFuture::from(handle.get_file()).await.ok()?.dyn_into::<web_sys::File>().ok()?;
+    Some(file.size() as u64)
+}
+
+/// Read these documents and hand them to the editor, one tab each (Open from Workspace). The editor
+/// drains the inbox every frame, so a slow read never blocks one.
+fn open_documents(project: String, names: Vec<String>, inbox: Inbox) {
+    for name in names.into_iter().filter(|name| is_document_name(name)) {
+        let (project, inbox) = (project.clone(), inbox.clone());
+        spawn_local(async move {
+            let path = document_path(&project, &name);
+            let read = with_lock(&format!("{LOCK}{project}"), "shared", {
+                let (project, name) = (project.clone(), name.clone());
+                async move { read_file(&project_dir(&project).await?, &name).await }
+            })
+            .await;
+            match read {
+                Ok(bytes) => {
+                    log::info!("atelier-cloud: opening {name} ({} bytes) from project {project}", bytes.len());
+                    inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, bytes, Some(path)));
+                    wake();
+                }
+                Err(e) => log::error!("atelier-cloud: could not open {name} in project {project}: {e}"),
+            }
+        });
+    }
+}
